# Python
__pycache__/
*.py[cod]

# Gowin EDA intermediates — the reports under impl/ are committed deliberately,
# but the tool also drops project state and bitstreams that are rebuildable.
*.fs
*.bin
*.binx
# a slash mid-pattern anchors to this file's directory, so impl/ must be
# reached with **/ — the old impl/gwsynthesis/*.db never matched anything
**/impl/*/*.db
**/impl/temp/
*.gprj.user

# Capture side-effects from the host tools
*.csv.status
*.csv.log

# OS
Thumbs.db
.DS_Store
desktop.ini
